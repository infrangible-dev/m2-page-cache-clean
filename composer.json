{
    "name": "infrangible/m2-page-cache-clean",
    "description": "Adds a \"Clean Page Cache\" button to the product and category edit pages, so the cached pages of just this product or category are refreshed.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Performance",
        "Admin tools",
        "Catalog",
        "clean page cache of one product",
        "refresh cached category page",
        "page cache button"
    ],
    "homepage": "https://bitbucket.org/infrangible/m2-page-cache-clean",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\PageCacheClean\\": "src"
        }
    }
}
